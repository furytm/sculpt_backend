generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id String @id @default(cuid())

  fullName String?
  email    String?
  phone    String?

  classId    String?
  scheduleId String?
  schedule   Schedule?     @relation(fields: [scheduleId], references: [id])
  sessionId  String?
  session    ClassSession? @relation(fields: [sessionId], references: [id])

  membershipId         String
  membership           Membership @relation(fields: [membershipId], references: [id])
  bookingFlowTokenHash String?    @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  membershipActivation MembershipActivation?
  bookingDate          DateTime?
  calendarEventId      String?
  calendarEventUrl     String?

  amount Int

  paymentReference   String            @unique
  paymentStatus      PaymentStatus     @default(PENDING)
  memberMembershipId String?
  memberMembership   MemberMembership? @relation(fields: [memberMembershipId], references: [id])
  memberSchedules    MemberSchedule[]

  preferredStartDate DateTime?
  availableDays      String[]
  preferredTimes     String[]
  bookingStatus      BookingStatus     @default(PENDING)
  paymentMethod      PaymentMethod     @default(PAYMISH)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  healthSafetyForm   HealthSafetyForm?

  @@index([sessionId])
  @@index([memberMembershipId])
  @@index([userId])
  @@index([bookingStatus])
}

enum MembershipPurchaseType {
  NEW
  RENEWAL
  UPGRADE
}

enum JournalStatus {
  DRAFT
  PUBLISHED
}

model Journal {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String        @db.Text
  content     String        @db.Text
  coverImage  String
  authorName  String        @default("Sculpt LAB")
  status      JournalStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([isFeatured, status])
  @@map("journals")
}

model MembershipPurchase {
  id                   String                 @id @default(cuid())
  userId               String?
  email                String
  membershipId         String
  previousMembershipId String?
  fullName             String?
  phone                String?
  memberMembership     MemberMembership?
  type                 MembershipPurchaseType
  paymentMethod PaymentMethod @default(PAYMISH)
paymentRejectionReason String?
membershipActivation MembershipActivation?

previousMemberMembershipId String?
  amount           Int
  paymentReference String        @unique
  paymentStatus    PaymentStatus @default(PENDING)

  carriedCredits Int           @default(0)
  // First class selected during initial purchase
  firstSessionId String?
  firstSession   ClassSession? @relation("MembershipPurchaseFirstSession", fields: [firstSessionId], references: [id], onDelete: SetNull)

  firstClassId String?

  // Health declaration submitted during checkout
  healthDeclarationAccepted Boolean @default(false)
  healthDeclarationNotes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  membership Membership @relation(fields: [membershipId], references: [id])

  @@index([userId])
  @@index([firstSessionId])
  @@index([email])
}

model HealthSafetyForm {
  id String @id @default(cuid())

  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  accepted           Boolean   @default(false)
  declarationVersion String?
  notes              String?
  acceptedAt         DateTime?

  // Keep your existing legacy fields for now.
  dateOfBirth DateTime?
  age         Int?

  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  pregnancy          String?
  pregnancyWeeks     Int?
  dueDate            DateTime?
  pregnancyClearance String?

  postpartum          String?
  deliveryDate        DateTime?
  postpartumClearance String?

  screeningAnswers Json?

  surgery          String?
  surgeryDetails   String?
  surgeryClearance String?

  consent   Json?
  signature String?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model Schedule {
  id String @id @default(cuid())

  className String
  // Kept for backward compatibility and to verify the tutorId backfill.
  tutorName String
  code      String @unique

  // The tutor this schedule belongs to, where known. Null until assigned
  // (for example a tutor with no Tutor record yet).
  tutorId String?
  tutor   Tutor?  @relation(fields: [tutorId], references: [id], onDelete: SetNull)

  dayOfWeek DayOfWeek

  startTime String
  endTime   String

  isActive Boolean @default(true)
  capacity Int     @default(5)

  sessions ClassSession[]

  bookings        Booking[]
  memberSchedules MemberSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayOfWeek])
  @@index([tutorName])
  @@index([tutorId])
  @@index([className])
  @@index([isActive])
}

// A tutor who teaches schedules. Tutors log in as a User with the TUTOR
// role through the normal login; userId links that account (at most one
// account per tutor, and one tutor per account). A tutor can exist before
// their account does.
model Tutor {
  id   String @id @default(cuid())
  name String @unique

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  schedules Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassSession {
  id String @id @default(cuid())

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  /**
   * Actual calendar date of this class session.
   * Example:
   * 2026-09-24
   */
  sessionDate DateTime

  /**
   * Capacity can inherit from Schedule.
   * If null, Schedule.capacity is used.
   */
  capacity Int?

  membershipPurchases MembershipPurchase[] @relation("MembershipPurchaseFirstSession")
  status              SessionStatus        @default(OPEN)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, sessionDate])
  @@index([sessionDate])
  @@index([status])
  @@index([scheduleId])
}

enum SessionStatus {
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

model MemberSchedule {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  classId String

  startDate DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, scheduleId])
  @@index([userId])
  @@index([bookingId])
  @@index([scheduleId])
  @@index([classId])
  @@index([isActive])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id String @id @default(cuid())

  fullName String

  email    String  @unique
  password String?

  phone String?

  provider AuthProvider @default(LOCAL)

  role               UserRole                @default(MEMBER)
  adminNotifications AdminNotification[]
  pushSubscriptions  AdminPushSubscription[]

  isEmailVerified Boolean @default(false)

  avatar String?

  bookings Booking[]

  refreshTokens RefreshToken[]

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailChangeRequest      EmailChangeRequest?
  activityLogs            MemberActivityLog[]

  memberSchedules    MemberSchedule[]
  memberships         MemberMembership[]
  healthSafetyForms   HealthSafetyForm[]
  membershipPurchases MembershipPurchase[]

  // Set for TUTOR accounts: the tutor this account belongs to.
  tutor Tutor?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MembershipActivation {
  id String @id @default(cuid())

  // Existing class-booking activation
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // New direct membership-purchase activation
  membershipPurchaseId String?             @unique
  membershipPurchase   MembershipPurchase?  @relation(fields: [membershipPurchaseId], references: [id], onDelete: Cascade)

  memberMembershipId String           @unique
  memberMembership   MemberMembership @relation(fields: [memberMembershipId], references: [id], onDelete: Cascade)

  membershipNumber String @unique
  tokenHash        String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model RefreshToken {
  id String @id @default(cuid())

  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())
}

enum MembershipType {
  GROUP
  PRIVATE
}

model Membership {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  type MembershipType

  price      Int
  period     String
  classLimit Int?
  duration   String

  features Json

  highlighted Boolean @default(false)
  badge       String?

  displayOrder Int     @default(0)
  autoRenew    Boolean @default(false)
  isActive     Boolean @default(true)

  bookings            Booking[]
  memberMemberships   MemberMembership[]
  membershipPurchases MembershipPurchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberMembership {
  id                   String              @id @default(cuid())
  membershipPurchaseId String?             @unique
  membershipPurchase   MembershipPurchase? @relation(fields: [membershipPurchaseId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id])

  bookings Booking[]

  status     MembershipStatus @default(ACTIVE)
  startDate  DateTime?
  expiryDate DateTime?

  creditsTotal Int?
  creditsUsed  Int  @default(0)
    membershipNumber String?

  activation MembershipActivation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([membershipNumber])
  @@index([status])
  @@index([expiryDate])
}

model EmailVerificationToken {
  id        String @id @default(cuid())
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AdminNotification {
  id      String @id @default(cuid())
  adminId String
  admin   User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  eventKey String
  type     String
  title    String
  message  String
  data     Json?
  readAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([adminId, eventKey])
  @@index([adminId, readAt, createdAt])
  @@map("admin_notifications")
}

model AdminPushSubscription {
  id      String @id @default(cuid())
  adminId String
  admin   User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
  @@map("admin_push_subscriptions")
}

model PasswordResetToken {
  id        String @id @default(cuid())
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// What a member (or guest, admin, the system or a payment webhook) tried
// to do, and how it ended. Written by src/activity-log/activity-log.service.ts
// only, outside business transactions. Metadata is allow-listed and never
// holds secrets or raw request/provider bodies.
//
// Deleting a member keeps their history (userId becomes null); any
// subjectEmail stays until retention removes the row.
model MemberActivityLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Only for guests without an account (normalized).
  subjectEmail String?

  // MEMBER | GUEST | ADMIN | SYSTEM | WEBHOOK
  actorType   String
  actorUserId String?

  // e.g. "membership.upgrade", "payment.callback"
  action String
  // e.g. INITIATED, PAYMENT_INITIALIZED, PROVIDER_FAILED, SUCCEEDED, FAILED
  stage  String
  // SUCCESS | FAILURE | INFO | WARNING
  status String

  description  String?
  errorCode    String?
  errorMessage String?
  httpStatus   Int?

  // MEMBERSHIP_PURCHASE | BOOKING
  entityType       String?
  entityId         String?
  paymentReference String?

  correlationId String?
  requestId     String?

  // Unique when set: a retried callback or webhook records one event.
  dedupeKey String? @unique

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([correlationId])
  @@index([paymentReference])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum EmailChangeStage {
  VERIFY_CURRENT
  VERIFY_NEW
}

// A member's pending email change: a code to the current address, then a
// code to the new address. User.email only changes after both succeed.
// One pending request per member (userId is unique).
model EmailChangeRequest {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The account email when the request started; the change is refused
  // if it no longer matches.
  currentEmail String
  newEmail     String

  stage EmailChangeStage @default(VERIFY_CURRENT)

  // HMAC of the code for the current stage; null once used.
  codeHash      String?
  codeExpiresAt DateTime?

  // Code checks and code emails for the current stage.
  attempts   Int       @default(0)
  sendCount  Int       @default(0)
  lastSentAt DateTime?

  currentVerifiedAt DateTime?

  // The whole request expires at this time, whatever the stage.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([newEmail])
  @@index([expiresAt])
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum UserRole {
  MEMBER
  ADMIN
  TUTOR
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  PAYMISH
  OFFLINE
  PAYSTACK
}
