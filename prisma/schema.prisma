generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id String @id @default(cuid())

  fullName String
  email    String
  phone    String

  classId    String?
  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id])

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  bookingDate DateTime?

  amount Int

  paymentReference   String            @unique
  paymentStatus      PaymentStatus     @default(PENDING)
  memberMembership   MemberMembership?
  preferredStartDate DateTime?
  availableDays      String[]
  preferredTimes     String[]
  bookingStatus      BookingStatus     @default(PENDING)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  healthSafetyForm HealthSafetyForm?
}

model HealthSafetyForm {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  dateOfBirth DateTime?
  age         Int?

  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  pregnancy          String?
  pregnancyWeeks     Int?
  dueDate            DateTime?
  pregnancyClearance String?

  postpartum          String?
  deliveryDate        DateTime?
  postpartumClearance String?

  screeningAnswers Json?

  surgery          String?
  surgeryDetails   String?
  surgeryClearance String?

  consent Json?

  signature     String?


  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model Schedule {
  id String @id @default(cuid())

  className String
  tutorName String
  code String @unique

  dayOfWeek DayOfWeek

  startTime String
  endTime   String

  isActive Boolean @default(true)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayOfWeek])
  @@index([tutorName])
  @@index([className])
  @@index([isActive])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id String @id @default(cuid())

  fullName String

  email    String  @unique
  password String?

  phone String?

  provider AuthProvider @default(LOCAL)

  role UserRole @default(MEMBER)

  isEmailVerified Boolean @default(false)

  avatar String?

  bookings Booking[]

  refreshTokens RefreshToken[]

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  memberships             MemberMembership[]
  healthSafetyForms       HealthSafetyForm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id String @id @default(cuid())

  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())
}

enum MembershipType {
  GROUP
  PRIVATE
}

model Membership {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  type MembershipType

  price      Int
  period     String
  classLimit Int?
  duration   String

  features Json

  highlighted Boolean @default(false)
  badge       String?

  displayOrder Int     @default(0)
  autoRenew    Boolean @default(false)
  isActive     Boolean @default(true)

  bookings          Booking[]
  memberMemberships MemberMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailVerificationToken {
  id        String @id @default(cuid())
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String @id @default(cuid())
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model MemberMembership {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id])

  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])

  status MembershipStatus @default(ACTIVE)

  startDate  DateTime?
  expiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiryDate])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum UserRole {
  MEMBER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
